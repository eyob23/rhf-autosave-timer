{
  "name": "rhf-autosave-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run build -w rhf-autosave && npm run dev -w rhf-autosave-demo",
    "build": "npm run build -w rhf-autosave && npm run build -w rhf-autosave-demo",
    "preview": "npm run preview -w rhf-autosave-demo"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
